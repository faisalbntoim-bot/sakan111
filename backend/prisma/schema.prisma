// SakanHub Financial Engine — DB schema.
// Money is stored as BigInt HALALAHS (integer minor units). Never as floats.
// All timestamps are stored as UTC; the app converts to Asia/Riyadh for display.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================================
// IDENTITY
// =========================================================================

model User {
  id           String   @id @default(cuid())
  phone        String   @unique                    // E.164
  email        String?  @unique
  nameAr       String
  nameEn       String?
  status       String   @default("active")         // active | suspended | closed
  pdplConsentAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                Role[]
  kyc                  Kyc?
  properties           Property[]         @relation("PropertyOwner")
  hostedProperties     PropertyHost[]
  bookingsAsCustomer   Booking[]          @relation("BookingCustomer")
  beneficiary          Beneficiary?
  auditLogs            AuditLog[]         @relation("AuditActor")
}

model Role {
  id      String @id @default(cuid())
  userId  String
  role    String                  // HOST | OWNER | OFFICE | MARKETER | CUSTOMER | ADMIN
  scope   String?                 // optional: officeId, propertyId ...
  grantedAt DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role, scope])
}

model Kyc {
  id           String   @id @default(cuid())
  userId       String   @unique
  level        String   @default("NONE")            // NONE | BASIC | FULL
  documentType String?                              // NATIONAL_ID | IQAMA | CR | PASSPORT
  documentRef  String?
  provider     String?
  verifiedAt   DateTime?
  status       String   @default("pending")         // pending | approved | rejected
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================================
// BENEFICIARIES & PAYOUT ACCOUNTS
// (payout requires KYC.level == FULL and status == approved)
// =========================================================================

model Beneficiary {
  id                    String   @id @default(cuid())
  userId                String   @unique
  provider              String                       // sandbox | moyasar | tap
  externalBeneficiaryId String?                      // provider's destination id
  ibanMasked            String?
  payoutEnabled         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlements Settlement[]
}

// =========================================================================
// PROPERTY & BOOKING (mirrors the existing iOS/web models)
// =========================================================================

model Property {
  id             String   @id @default(cuid())
  listingNumber  String   @unique
  ownerId        String
  officeId       String?                             // free-form FK reference (Office table optional)
  category       String                              // apartment | villa | duplex | studio | land | office | shop | farm | commercial | building
  purpose        String                              // sale | rent | daily | monthly | commercial_rent
  status         String   @default("available")      // available | reserved | sold | rented | hidden
  currency       String   @default("SAR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ---- REGA advertisement compliance (nullable — populated when the listing
  //      goes through the SUBMITTED → VERIFIED → PUBLISHED lifecycle) ----
  advertisementLifecycle String  @default("DRAFT")   // DRAFT | SUBMITTED | VERIFIED | PUBLISHED | EXPIRED | SUSPENDED | REMOVED
  regaLicenseNumber      String?                     // REGA advertisement licence — visible per REGA rules
  regaLicenseIssuedAt    DateTime?
  regaLicenseExpiresAt   DateTime?
  regaSubmittedAt        DateTime?
  regaVerifiedAt         DateTime?
  regaVerifiedByUserId   String?                     // admin who confirmed
  regaSuspendedAt        DateTime?
  regaSuspendReason      String?
  regaComplianceRef      String?                     // opaque external reference

  // ---- Property Data v2 (all nullable — safe defaults, no backfill invented) ----
  // Location
  city            String?                            // e.g. "الرياض"
  district        String?                            // e.g. "حي الملقا"
  addressText     String?                            // free-form full address (owner-entered)
  latitude        Float?                             // -90 .. 90
  longitude       Float?                             // -180 .. 180

  // Commercial
  priceHalalahs   BigInt?                            // minor units — same convention as Booking.grossAmountHalalahs
  pricePeriod     String?                            // TOTAL | YEAR | MONTH | WEEK | DAY

  // Dimensions (all in square metres; ints — cm-level precision is not useful for listings)
  areaSqm         Int?                               // primary listed area
  landAreaSqm     Int?                               // for villas/lands
  builtAreaSqm    Int?                               // for villas — the "بناء" figure

  // Rooms
  bedrooms        Int?
  bathrooms       Int?
  livingRooms     Int?
  kitchens        Int?

  // Building
  floorNumber        Int?
  totalFloors        Int?
  propertyAgeYears   Int?
  yearBuilt          Int?

  // Amenities (boolean flags — nullable → "unknown", false → "confirmed absent")
  furnished             Boolean?
  parkingSpaces         Int?
  hasElevator           Boolean?
  hasPool               Boolean?
  hasBalcony            Boolean?
  hasYard               Boolean?
  hasMaidRoom           Boolean?
  hasDriverRoom         Boolean?
  hasAirConditioning    Boolean?

  // Publishing timestamps (independent of REGA lifecycle — an owner may
  // schedule a future publish or set an expiry). Nullable to preserve
  // backward compatibility for rows created before v2.
  publishedAt     DateTime?
  expiresAt       DateTime?

  owner  User          @relation("PropertyOwner", fields: [ownerId], references: [id])
  hosts  PropertyHost[]
  bookings Booking[]
  complaints Complaint[]

  @@index([ownerId])
  @@index([advertisementLifecycle])
  @@index([regaLicenseNumber])
  // Property Data v2 indexes — narrow, high-value only
  @@index([city, district])
  @@index([status, publishedAt])
  @@index([category, purpose])
  @@index([priceHalalahs])
}

// =========================================================================
// ADVERTISER + IDENTITY VERIFICATION (Nafath-shaped, no live provider yet)
// =========================================================================

/// Represents a Nafath / Elm / manual identity verification event.
/// We NEVER store the raw national-id here — only the provider's opaque
/// reference and the outcome.
model AdvertiserVerification {
  id            String   @id @default(cuid())
  userId        String
  provider      String                              // nafath | elm | manual
  externalRef   String?                             // opaque; NEVER the raw ID
  documentType  String?                             // national_id | iqama | cr
  status        String   @default("pending")        // pending | verified | rejected | expired
  verifiedAt    DateTime?
  expiresAt     DateTime?
  rejectionReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
}

// =========================================================================
// COMPLAINTS
// =========================================================================

model Complaint {
  id             String    @id @default(cuid())
  complainantId  String?                            // nullable — anonymous complaints allowed
  propertyId     String?
  bookingId      String?
  category       String    @default("advertisement") // advertisement | payment | conduct | other
  description    String
  status         String    @default("open")          // open | in_review | resolved | dismissed
  adminNotes     String?
  resolution     String?
  resolvedAt     DateTime?
  resolvedById   String?
  attachmentRefs String?                             // JSON array of MediaAsset ids
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property       Property? @relation(fields: [propertyId], references: [id])

  @@index([status, createdAt])
  @@index([propertyId])
}

// =========================================================================
// MEDIA / STORAGE (private-by-default; signed URLs served by the API)
// =========================================================================

model MediaAsset {
  id            String   @id @default(cuid())
  ownerUserId   String                              // whoever uploaded it
  propertyId    String?
  kind          String                              // image | video | document
  provider      String                              // sandbox | s3 | r2
  providerKey   String                              // object key on the provider (opaque)
  mimeType      String
  sizeBytes     Int
  sha256        String                              // client-computed integrity
  visibility    String   @default("private")        // private | public
  createdAt     DateTime @default(now())

  @@index([ownerUserId])
  @@index([propertyId])
}

model PropertyHost {
  id          String   @id @default(cuid())
  propertyId  String
  hostId      String
  isPrimary   Boolean  @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  host     User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  @@unique([propertyId, hostId])
}

model Booking {
  id                  String   @id @default(cuid())
  propertyId          String
  customerId          String
  hostId              String                       // host who receives funds (for DAILY_RENTAL)
  officeId            String?
  marketerId          String?
  transactionType     String                       // DAILY_RENTAL | LONG_TERM_RENTAL | COMMERCIAL_RENTAL | SALE
  checkIn             DateTime?
  checkOut            DateTime?
  nights              Int?
  grossAmountHalalahs BigInt                       // total item amount BEFORE platform fee & tax
  currency            String   @default("SAR")
  status              String   @default("draft")   // draft | pending_payment | confirmed | cancelled | completed
  idempotencyKey      String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  confirmedAt         DateTime?

  property Property @relation(fields: [propertyId], references: [id])
  customer User     @relation("BookingCustomer", fields: [customerId], references: [id])

  items    BookingItem[]
  payments Payment[]
  invoice  Invoice?
}

model BookingItem {
  id                 String  @id @default(cuid())
  bookingId          String
  kind               String                       // NIGHTLY | CLEANING | SERVICE_FEE | DISCOUNT
  amountHalalahs     BigInt
  quantity           Int     @default(1)
  taxable            Boolean @default(false)
  description        String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// =========================================================================
// COMMISSION RULES (DB-driven — NO hard-coded percentages in code)
// =========================================================================

model CommissionRule {
  id                  String   @id @default(cuid())
  transactionType     String                       // DAILY_RENTAL | LONG_TERM_RENTAL | COMMERCIAL_RENTAL | SALE | ADVERTISEMENT | SUBSCRIPTION | SERVICE
  propertyType        String?                      // optional refinement
  platformPercentage  Float?                       // 0..100 (nullable if flat fee)
  minimumFeeHalalahs  BigInt?
  maximumFeeHalalahs  BigInt?
  officePercentage    Float?                       // share OF platform fee going to office (default 0)
  marketerPercentage  Float?
  currency            String   @default("SAR")
  priority            Int      @default(100)       // lower wins
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  active              Boolean  @default(true)
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([transactionType, propertyType, active])
}

// =========================================================================
// TAX RULES (DB-driven — residential rent is generally exempt in SA)
// =========================================================================

model TaxRule {
  id              String   @id @default(cuid())
  serviceType     String                          // RENTAL_RESIDENTIAL | RENTAL_COMMERCIAL | PLATFORM_FEE | BROKERAGE | ADVERTISEMENT | SUBSCRIPTION | SALE
  transactionType String?
  ratePercent     Float                           // 0..100
  taxable         Boolean  @default(true)
  reasonCode      String?                          // e.g. "SA_VAT_RESIDENTIAL_EXEMPT"
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serviceType, transactionType, active])
}

model TaxRecord {
  id                    String  @id @default(cuid())
  paymentId             String?
  bookingId             String?
  serviceType           String
  taxableAmountHalalahs BigInt
  ratePercent           Float
  taxAmountHalalahs     BigInt
  taxStatus             String                    // applied | exempt | not_applicable
  taxReason             String?
  createdAt             DateTime @default(now())

  @@index([paymentId])
}

// =========================================================================
// PAYMENT & WEBHOOK
// =========================================================================

model Payment {
  id                    String   @id @default(cuid())
  bookingId             String?
  subscriptionId        String?
  advertisementId       String?
  type                  String                       // CHARGE | REFUND | PAYOUT | ADJUSTMENT
  grossAmountHalalahs   BigInt
  currency              String   @default("SAR")
  status                String   @default("pending") // pending | captured | failed | refunded | partial_refunded | cancelled
  provider              String                       // sandbox | moyasar | tap
  providerPaymentId     String?  @unique             // dedup by provider id
  providerStatus        String?
  gatewayFeeHalalahs    BigInt   @default(0)
  idempotencyKey        String   @unique
  metadata              String?                      // JSON string
  createdAt             DateTime @default(now())
  capturedAt            DateTime?
  updatedAt             DateTime @updatedAt

  booking       Booking?       @relation(fields: [bookingId], references: [id])
  events        PaymentEvent[]
  refunds       Refund[]
  ledgerEntries LedgerEntry[]
  settlements   Settlement[]
  invoice       Invoice?

  @@index([status])
}

model PaymentEvent {
  id           String   @id @default(cuid())
  paymentId    String
  kind         String                       // created | authorized | captured | failed | refunded | webhook.received
  data         String                       // JSON string
  createdAt    DateTime @default(now())

  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id                 String   @id @default(cuid())
  provider           String
  externalEventId    String                    // provider-supplied id (used for dedup)
  eventType          String
  signatureVerified  Boolean  @default(false)
  processed          Boolean  @default(false)
  payload            String                    // raw JSON string
  receivedAt         DateTime @default(now())
  processedAt        DateTime?

  @@unique([provider, externalEventId])
  @@index([processed])
}

// =========================================================================
// DOUBLE-ENTRY LEDGER
// =========================================================================

model Account {
  id          String   @id @default(cuid())
  code        String   @unique                // e.g. "PLATFORM_REVENUE", "VAT_PAYABLE", "HOST_PAYABLE:userId"
  name        String
  ownerUserId String?                          // set for per-user accounts (host payable, etc.)
  type        String                          // asset | liability | equity | revenue | expense
  currency    String   @default("SAR")
  createdAt   DateTime @default(now())

  entries LedgerEntry[]

  @@index([ownerUserId])
}

/// Immutable double-entry ledger. To reverse a transaction, insert offsetting entries.
model LedgerEntry {
  id               String   @id @default(cuid())
  transactionRef   String                       // logical grouping (e.g. payment.id)
  accountId        String
  debitHalalahs    BigInt   @default(0)
  creditHalalahs   BigInt   @default(0)
  currency         String   @default("SAR")
  paymentId        String?
  bookingId        String?
  refundId         String?
  description      String?
  createdAt        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([transactionRef])
  @@index([accountId, createdAt])
}

// =========================================================================
// REFUND & SETTLEMENT
// =========================================================================

model Refund {
  id                    String   @id @default(cuid())
  paymentId             String
  amountHalalahs        BigInt
  currency              String   @default("SAR")
  reason                String?
  status                String   @default("pending")  // pending | processing | completed | failed | cancelled
  provider              String
  providerRefundId      String?
  idempotencyKey        String   @unique
  createdBy             String?
  createdAt             DateTime @default(now())
  completedAt           DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])
}

model Settlement {
  id                 String   @id @default(cuid())
  paymentId          String
  beneficiaryId      String
  amountHalalahs     BigInt
  currency           String   @default("SAR")
  status             String   @default("PENDING") // PENDING | ELIGIBLE | PROCESSING | PAID | FAILED | CANCELLED
  scheduledAt        DateTime?
  processedAt        DateTime?
  providerReference  String?  @unique
  failureReason      String?
  retryCount         Int      @default(0)
  lastRetryAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payment     Payment     @relation(fields: [paymentId], references: [id])
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])

  @@index([status])
  @@index([beneficiaryId, status])
}

// =========================================================================
// INVOICE (ZATCA-ready shape; XML generator is a stub — see invoice.ts)
// =========================================================================

model Invoice {
  id                    String   @id @default(cuid())
  invoiceNumber         String   @unique
  bookingId             String?  @unique
  paymentId             String?  @unique
  sellerName            String                       // SakanHub or Host — depends on the invoice kind
  sellerVatNumber       String?
  buyerName             String
  buyerVatNumber        String?
  subtotalHalalahs      BigInt
  taxableAmountHalalahs BigInt
  taxRatePercent        Float    @default(0)
  taxAmountHalalahs     BigInt   @default(0)
  totalHalalahs         BigInt
  currency              String   @default("SAR")
  issueDate             DateTime @default(now())
  status                String   @default("issued")  // draft | issued | credited | cancelled
  pdfRef                String?                       // opaque object-storage key
  xmlRef                String?                       // ZATCA UBL XML key
  createdAt             DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
}

// =========================================================================
// ADVERTISEMENTS (product pricing, NOT commission %)
// =========================================================================

model AdProduct {
  id           String   @id @default(cuid())
  code         String   @unique                     // NORMAL | FEATURED | PREMIUM | VIP
  nameAr       String
  nameEn       String?
  priceHalalahs BigInt
  currency     String   @default("SAR")
  durationDays Int
  taxable      Boolean  @default(true)
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model Advertisement {
  id              String    @id @default(cuid())
  propertyId      String
  buyerUserId     String
  productCode     String                            // FK by code to AdProduct
  priceHalalahs   BigInt
  taxHalalahs     BigInt   @default(0)
  totalHalalahs   BigInt
  currency        String   @default("SAR")
  activeFrom      DateTime?
  activeUntil     DateTime?
  status          String   @default("pending")      // pending | active | expired | cancelled
  createdAt       DateTime @default(now())

  @@index([propertyId])
}

// =========================================================================
// SUBSCRIPTIONS
// =========================================================================

model SubscriptionPlan {
  id             String  @id @default(cuid())
  code           String  @unique                   // INDIVIDUAL | MARKETER | OFFICE | ENTERPRISE
  nameAr         String
  nameEn         String?
  monthlyHalalahs BigInt
  yearlyHalalahs  BigInt
  trialDays      Int     @default(0)
  taxable        Boolean @default(true)
  active         Boolean @default(true)
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  planCode      String
  billingCycle  String                          // monthly | yearly
  status        String   @default("trialing")   // trialing | active | past_due | cancelled | expired
  startedAt     DateTime @default(now())
  currentPeriodEnd DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
}

// =========================================================================
// AUDIT / IDEMPOTENCY
// =========================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String                              // PAYMENT.CAPTURED, RULE.UPDATED, ...
  entity     String
  entityId   String
  before     String?
  after      String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])
  @@index([entity, entityId])
}

/// Idempotency store: a client sends `Idempotency-Key`; we memoise the response
/// for a short window so retries return the same result without double-charge.
model IdempotencyKey {
  key         String   @id
  scope       String                              // route:body-hash
  requestHash String
  responseJson String?
  status      String   @default("in_flight")     // in_flight | completed | failed
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([scope])
}

// =========================================================================
// AUTHENTICATION — OTP + JWT REFRESH
// =========================================================================

/// One-time code challenges. `codeHash` = sha256(salt + code); never store the code itself.
/// Rate-limit is enforced per phone by counting recent unconsumed challenges.
model OtpChallenge {
  id            String   @id @default(cuid())
  phone         String                                // E.164 (+9665…)
  codeHash      String                                // sha256(salt + code) as hex
  salt          String                                // hex, 16 bytes
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

/// Refresh tokens are stored hashed; rotation revokes the previous one.
model RefreshToken {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique                     // sha256(refreshToken) hex
  parentId      String?                              // previous token in a rotation chain
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, revokedAt])
}

// =========================================================================
// RECOMMENDATION & MARKET PULSE — user event stream
// =========================================================================

/// Append-only stream of user interactions used by:
///   * Recommendation Engine V1 (deterministic scoring — no ML) to infer
///     per-user preferences (city / district / property type / price range).
///   * Market Pulse (deals volume, trending areas, hot properties) via
///     time-windowed aggregations.
///
/// Privacy: `userId` is nullable to allow anonymous session tracking.
/// `metadata` is a whitelist JSON blob (validated at the route boundary);
/// NEVER store credentials, OTPs, JWTs, card numbers, or DM content here.
model UserEvent {
  id                  String   @id @default(cuid())
  userId              String?                              // null for anonymous sessions
  anonymousSessionId  String?                              // opaque, rotated per browser session
  eventType           String                               // see EVENT_WEIGHTS whitelist
  propertyId          String?                              // FK-shape (not enforced — event survives property delete)
  city                String?                              // denormalised for aggregation queries
  district            String?
  propertyType        String?                              // apartment | villa | duplex | studio | land | ...
  purpose             String?                              // sale | rent | daily | ...
  priceHalalahs       BigInt?                              // denormalised — halalah minor units
  metadata            String   @default("{}")              // JSON string; whitelist-validated
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([propertyId, createdAt])
  @@index([eventType, createdAt])
  @@index([city, district, createdAt])
}
